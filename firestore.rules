rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 有登入（Google 或 Email）才算數；匿名、沒登入的人什麼都不能讀寫
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function me() { return request.auth.uid; }
    function listData(listId) {
      return get(/databases/$(database)/documents/lists/$(listId)).data;
    }
    function isMember(listId) {
      return signedIn() && me() in listData(listId).members;
    }

    // 擁有者：可以改名、移出成員、換邀請碼（不能把擁有者換人，也不能把自己移出）
    function isOwnerUpdate() {
      return resource.data.get('owner', '') == me()
        && request.resource.data.owner == me()
        && me() in request.resource.data.members;
    }
    // 一般成員：可以改列表內容、改自己的名字、自己離開；不能動擁有者、邀請碼和別人
    function isMemberUpdate() {
      return me() in resource.data.members
        && request.resource.data.get('owner', '') == resource.data.get('owner', '')
        && request.resource.data.get('invite', '') == resource.data.get('invite', '')
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([me()]);
    }
    // 加入：拿著正確的邀請碼，只能把「自己」加進成員名單
    function isJoin() {
      return !(me() in resource.data.members)
        && resource.data.get('invite', '') != ''
        && request.resource.data.get('joinToken', '') == resource.data.invite
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinToken'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([me()])
        && me() in request.resource.data.members;
    }
    // 舊版建立、還沒有擁有者的列表：第一個打開的成員變成擁有者
    function isClaimOwner() {
      return me() in resource.data.members
        && resource.data.get('owner', '') == ''
        && request.resource.data.owner == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'invite']);
    }


    // 每個人自己的資料：只有自己能讀寫
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && me() == uid;
    }

    // 共用列表：只有成員看得到
    match /lists/{listId} {
      allow get: if signedIn() && me() in resource.data.members;
      allow list: if false;

      // 建立：自己是擁有者，成員只有自己，要有邀請碼
      allow create: if signedIn()
        && request.resource.data.owner == me()
        && request.resource.data.members.keys().hasOnly([me()])
        && me() in request.resource.data.members
        && request.resource.data.invite is string
        && request.resource.data.invite.size() >= 12;

      allow update: if signedIn() && (isOwnerUpdate() || isMemberUpdate() || isJoin() || isClaimOwner());

      // 刪除整個列表：只有擁有者
      allow delete: if signedIn() && resource.data.get('owner', '') == me();

      match /items/{itemId} {
        allow read, write: if isMember(listId);
      }
      match /images/{imageId} {
        allow read, write: if isMember(listId);
      }
    }
  }
}
